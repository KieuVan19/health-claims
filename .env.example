# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/health_claims
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=health_claims

# Backend
NODE_ENV=development
PORT=3001
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend
VITE_API_URL=http://localhost:3001/api

# Email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@healthclaims.local

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
